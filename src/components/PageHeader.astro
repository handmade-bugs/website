---
import { SITE_TITLE } from "../consts";
---

<header>
  <h1 class="site-name">
    <a href="/">{SITE_TITLE}</a>
  </h1>
</header>

<style>
  .site-name {
    margin: 0 0 1.5rem;
    padding-bottom: 1.5rem;
    border-bottom: thin solid #ccc;
    font-size: 1.25rem;
  }

  .site-name a:any-link {
    color: inherit;
    text-decoration: none;
  }
</style>
